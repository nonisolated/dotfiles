[user]
	name = Dmitry Baginsky
	email = dmitri.baginski@gmail.com
[github]
	user = betraying
[core]
	excludesfile = ~/.gitignore
	attributesfile = ~/.gitattributes
[rerere]
	enabled = true
[pull]
	rebase = true
[status]
	showStash = true
[rebase]
	autostash = true
	autosquash = true
	abbreviateCommands = true
[stash]
	showPatch = true
[push]
	default = current
[difftool "Kaleidoscope"]
	cmd = ksdiff --partial-changeset --relative-path \"$MERGED\" -- \"$LOCAL\" \"$REMOTE\"
[difftool]
	prompt = false
	trustExitCode = true
[diff]
	tool = Kaleidoscope
[mergetool "Kaleidoscope"]
	cmd = ksdiff --merge --output \"$MERGED\" --base \"$BASE\" -- \"$LOCAL\" --snapshot \"$REMOTE\" --snapshot
	trustExitCode = true
[mergetool]
	prompt = false
	keepBackup = false
[merge]
	tool = Kaleidoscope
[tig "color"]
	cursor = default default reverse
	id = yellow default
	title-focus = black green reverse
	author = white default
	date = cyan default
[diff "swift"]
    xfuncname = ^[ \t]*((struct|class|actor|func|extension)[ \t].*)$
[credential]
	helper = store
[alias]
	fstatus = "!git status --porcelain | awk '\n\n{\n\n  split($2, path, \"/\");\n\n  dir = path[1];\n\n  count[dir]++;\n\n}\n\nEND {\n\n  for (d in count) {\n\n    printf \"%-20s %d files\\n\", d, count[d];\n\n  }\n\n}\n\n'"
	tree-status = "!git status --porcelain | awk '\nBEGIN {\n  red = \"\\033[31m\";\n  green = \"\\033[32m\";\n  yellow = \"\\033[33m\";\n  reset = \"\\033[0m\";\n}\n{\n  status = $1;\n  file = $2;\n\n  split(file, parts, \"/\");\n\n  dir = parts[1];\n  subdir = (length(parts) > 2 ? parts[2] : \"\");\n  name = parts[length(parts)];\n\n  if (name == \"\") {\n    name = parts[length(parts)-1];\n    isDir = 1;\n  } else {\n    isDir = 0;\n  }\n\n  key = dir \"|\" subdir;\n\n  # --- статус ---\n  if (status == \"??\") {\n    x = \"?\"; y = \" \";\n  } else {\n    x = substr(status,1,1);\n    y = substr(status,2,1);\n    if (x == \"\") x = \" \";\n    if (y == \"\") y = \" \";\n  }\n\n  # --- цвет ---\n  color = green;\n  if (x == \"D\" || y == \"D\") {\n    color = red;\n  } else if (x == \"M\" || y == \"M\") {\n    color = yellow;\n  }\n\n  # --- если это untracked папка → не добавляем как файл\n  if (status == \"??\" && isDir) {\n    dirs[dir] = 1;\n    subdirs[key] = 1;\n    untrackedDir[key] = 1;\n    next;\n  }\n\n  count[key]++;\n  files[key, count[key]] = sprintf(\"%s    - [%s|%s] %s%s\", color, x, y, name, reset);\n\n  dirs[dir] = 1;\n  subdirs[key] = 1;\n}\nEND {\n  for (d in dirs) {\n    print d \"/\";\n\n    for (k in subdirs) {\n      split(k, p, \"|\");\n      if (p[1] == d && p[2] != \"\") {\n        line = \"  \" p[2] \"/\";\n\n        # если это чисто untracked папка\n        if (k in untrackedDir) {\n          print green line \"  [?]\" reset;\n          continue;\n        }\n\n        print line;\n\n        for (i = 1; i <= count[k]; i++) {\n          print files[k, i];\n        }\n      }\n    }\n\n    rootKey = d \"|\";\n    if (rootKey in subdirs) {\n      for (i = 1; i <= count[rootKey]; i++) {\n        print files[rootKey, i];\n      }\n    }\n  }\n}\n'"
