# git worktree
alias gwt='git worktree'

wt() {
    local branch="$1"
    local project
    local worktree

    project="$(basename "$(git rev-parse --show-toplevel)")"
    worktree="$(git rev-parse --show-toplevel)/../${project}-${branch//\//-}"

    cd "$worktree"
}

gwtr() {
    local target_branch="${1}"
    local worktree
    local main_worktree
    local gitfile

    if [[ -z "$target_branch" ]]; then
        # Старое поведение — удалить текущий worktree
        gitfile="$PWD/.git"
        
        if [[ ! -f "$gitfile" ]]; then
            echo "gwtr: .git file not found, are you in a worktree?" >&2
            return 1
        fi

        local gitdir=$(grep "^gitdir:" "$gitfile" | cut -d' ' -f2)
        
        if [[ -z "$gitdir" ]]; then
            echo "gwtr: cannot parse .git file" >&2
            return 1
        fi

        worktree="$PWD"
        main_worktree=$(echo "$gitdir" | sed 's|/.git/worktrees/.*||')
    else
        # Новое поведение — удалить worktree по названию ветки/ID
        main_worktree="$(git rev-parse --show-toplevel 2>/dev/null)"
        
        if [[ -z "$main_worktree" ]]; then
            echo "gwtr: not in a git repository" >&2
            return 1
        fi

        # Ищем worktree, название которого содержит target_branch
        while IFS= read -r line; do
            if [[ -z "$line" ]]; then continue; fi
            local wt_path=$(echo "$line" | cut -d' ' -f2)
            local wt_name=$(basename "$wt_path")
            if [[ "$wt_name" == *"$target_branch"* ]]; then
                worktree="$wt_path"
                break
            fi
        done < <(git -C "$main_worktree" worktree list --porcelain 2>/dev/null)

        if [[ -z "$worktree" ]]; then
            echo "gwtr: worktree matching '$target_branch' not found" >&2
            return 1
        fi
    fi

    if [[ ! -d "$main_worktree/.git" ]]; then
        echo "gwtr: main repository not found at $main_worktree" >&2
        return 1
    fi

    cd "$main_worktree" || return 1
    if git worktree remove "$worktree" 2>/dev/null; then
        echo "✅ Worktree успешно удалён: $(basename "$worktree")"
        return 0
    fi

    echo ""
    echo "❌ Failed to remove worktree: $worktree"
    echo ""
    echo "Варианты действий:"
    echo "1) Удалить с флагом --force"
    echo "2) Очистить данные worktree в основном репо"
    echo "3) Просто удалить директорию worktree"
    echo "4) Отменить"
    echo ""
    
    print -n "Выберите (1-4): "
    read choice

    case "$choice" in
        1)
            echo "Удаляю с флагом --force..."
            if git worktree remove "$worktree" --force; then
                echo "✅ Worktree успешно удалён: $(basename "$worktree")"
                return 0
            else
                echo "❌ Ошибка при удалении"
                return 1
            fi
            ;;
        2)
            echo "Очищаю метаданные worktree..."
            local wtree_name=$(basename "$worktree")
            rm -rf "$main_worktree/.git/worktrees/$wtree_name" 2>/dev/null
            if rm -rf "$worktree"; then
                echo "✅ Worktree очищен: $wtree_name"
                return 0
            else
                echo "❌ Не удалось удалить директорию"
                return 1
            fi
            ;;
        3)
            echo "Удаляю директорию worktree..."
            if rm -rf "$worktree"; then
                echo "✅ Директория удалена: $(basename "$worktree")"
                return 0
            else
                echo "❌ Не удалось удалить директорию"
                return 1
            fi
            ;;
        4)
            echo "Отменено"
            return 1
            ;;
        *)
            echo "❌ Неверный выбор"
            return 1
            ;;
    esac
}

gwta() {
    local branch="$1"
    local project
    local worktree

    project="$(basename "$(git rev-parse --show-toplevel)")"
    worktree="../${project}-${branch//\//-}"

    if git show-ref --verify --quiet "refs/heads/$branch"; then
        git worktree add "$worktree" "$branch"
    else
        git worktree add "$worktree" -b "$branch"
    fi

    cd "$worktree"
}

