# Functions

gcpto() {
  local target_branch=$1
  local count=$2

  if [[ -z "$target_branch" || -z "$count" ]]; then
    echo "Usage: gcpto <target-branch> <count>"
    return 1
  fi

  local original_branch
  original_branch=$(git rev-parse --abbrev-ref HEAD)

  local commits=($(git log --pretty=format:%H -n "$count" | tail -r))

  git checkout "$target_branch" || return 1

  local new_branch="${original_branch}-${target_branch}"
  git checkout -b "$new_branch" || return 1
  echo "Created and switched to new branch: $new_branch"

  for commit in "${commits[@]}"; do
    git cherry-pick "$commit" || {
      echo "❌ Cherry-pick failed on commit $commit"
      return 1
    }
  done

  echo "✅ Cherry-picked ${#commits[@]} commit(s) to $new_branch"
}

