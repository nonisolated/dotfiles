#!/bin/bash
# Configure worktree prefix for current project

if [[ ! -d ".git" ]]; then
    echo "Error: not in a git repository root" >&2
    return 1
fi

local repo_name=$(basename "$(git rev-parse --show-toplevel)")

echo "Current repository: $repo_name"
print -n "Enter worktree prefix (e.g., MOB, JIRA, etc): "
read prefix

if [[ -z "$prefix" ]]; then
    echo "Error: prefix cannot be empty" >&2
    return 1
fi

# Save to .git/config (local, not committed)
git config --local worktree.prefix "$prefix"
echo "✅ Prefix set to: $prefix"
echo "Saved in: .git/config (local, not committed)"
